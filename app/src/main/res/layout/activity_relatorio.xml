<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:fillViewport="true"
    android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">
        <TextView style="@style/TituloGrande" android:text="@string/relatorio"/>
        <TextView style="@style/TextoApoio" android:text="@string/relatorio_apoio"/>
        <ProgressBar
            android:id="@+id/loading"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:visibility="gone"/>
        <Space android:layout_width="1dp" android:layout_height="24dp"/>
        <com.google.android.material.card.MaterialCardView
            style="@style/Cartao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">
                <TextView style="@style/TituloSecao" android:text="@string/progresso_projeto"/>
                <TextView
                    android:id="@+id/numero_percentagem"
                    style="@style/TituloGrande"
                    android:textSize="56sp"
                    android:textColor="@color/roxo"
                    android:layout_marginTop="16dp"/>
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progresso_relatorio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp"
                    android:progress="0"
                    app:indicatorColor="@color/roxo"
                    app:trackColor="@color/roxo_suave"
                    app:trackThickness="8dp"
                    app:trackCornerRadius="4dp"/>
                <TextView style="@style/TextoApoio" android:text="@string/concluidas"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginTop="12dp">
            <LinearLayout
                style="@style/TileRelatorio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView android:id="@+id/numero_total" style="@style/TileNumero" android:textColor="@color/texto"/>
                <TextView style="@style/TileRotulo" android:text="@string/total"/>
            </LinearLayout>
            <LinearLayout
                style="@style/TileRelatorio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:id="@+id/numero_concluidas"
                    style="@style/TileNumero"
                    android:textColor="@color/verde"/>
                <TextView style="@style/TileRotulo" android:text="@string/concluidas"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginTop="12dp">
            <LinearLayout
                style="@style/TileRelatorio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView android:id="@+id/numero_em_curso" style="@style/TileNumero" android:textColor="@color/azul"/>
                <TextView style="@style/TileRotulo" android:text="@string/em_curso"/>
            </LinearLayout>
            <LinearLayout
                style="@style/TileRelatorio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:id="@+id/numero_por_fazer"
                    style="@style/TileNumero"
                    android:textColor="@color/texto"/>
                <TextView style="@style/TileRotulo" android:text="@string/por_fazer"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginTop="12dp">
            <LinearLayout
                style="@style/TileRelatorio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:id="@+id/numero_atrasadas"
                    style="@style/TileNumero"
                    android:textColor="@color/vermelho"/>
                <TextView style="@style/TileRotulo" android:text="@string/atrasadas"/>
            </LinearLayout>
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="28dp"/>
        <TextView style="@style/TituloSecao" android:text="@string/por_pessoa"/>
        <Space android:layout_width="1dp" android:layout_height="12dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:id="@+id/linha_por_pessoa"
            android:background="@drawable/bg_cartao"
            android:padding="20dp">
</LinearLayout>
    </LinearLayout>
</ScrollView>
