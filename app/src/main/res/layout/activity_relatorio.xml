<?xml version="1.0" encoding="utf-8"?>
<!-- Relatório: ConstraintLayout em coluna. Os blocos de números formam
     cadeias horizontais (dois por linha) com a mesma largura. -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:fillViewport="true"
    android:clipToPadding="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/margem"
        android:paddingEnd="@dimen/margem"
        android:paddingBottom="@dimen/margem_grande">

        <TextView
            android:id="@+id/titulo_relatorio"
            style="@style/TituloGrande"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/relatorio"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/texto_apoio_relatorio"
            style="@style/TextoApoio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/relatorio_apoio"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/titulo_relatorio"/>

        <!-- Indicador de carregamento: visível enquanto o relatório é obtido. -->
        <ProgressBar
            android:id="@+id/loading"
            android:layout_width="@dimen/altura_indicador"
            android:layout_height="@dimen/altura_indicador"
            android:layout_marginTop="@dimen/margem_pequena"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/texto_apoio_relatorio"/>

        <!-- Progresso do projeto -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cartao_progresso"
            style="@style/Cartao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/loading">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/espaco_24">

                <TextView
                    android:id="@+id/titulo_progresso"
                    style="@style/TituloSecao"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/progresso_projeto"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <TextView
                    android:id="@+id/numero_percentagem"
                    style="@style/TituloGrande"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_16"
                    android:textColor="@color/roxo"
                    android:textSize="56sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/titulo_progresso"/>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progresso_relatorio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margem_pequena"
                    android:layout_marginBottom="@dimen/espaco_8"
                    android:progress="0"
                    app:indicatorColor="@color/roxo"
                    app:trackColor="@color/roxo_suave"
                    app:trackThickness="@dimen/espaco_8"
                    app:trackCornerRadius="@dimen/espaco_4"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/numero_percentagem"/>

                <TextView
                    android:id="@+id/texto_concluidas"
                    style="@style/TextoApoio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/concluidas"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/progresso_relatorio"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Primeira linha: total e concluídas -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tile_total"
            style="@style/TileRelatorio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem_pequena"
            app:layout_constraintEnd_toStartOf="@id/tile_concluidas"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cartao_progresso">

            <TextView
                android:id="@+id/numero_total"
                style="@style/TileNumero"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/texto"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                android:id="@+id/rotulo_total"
                style="@style/TileRotulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/total"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/numero_total"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tile_concluidas"
            style="@style/TileRelatorio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem_pequena"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tile_total"
            app:layout_constraintTop_toBottomOf="@id/cartao_progresso">

            <TextView
                android:id="@+id/numero_concluidas"
                style="@style/TileNumero"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/verde"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                android:id="@+id/rotulo_concluidas"
                style="@style/TileRotulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/concluidas"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/numero_concluidas"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Segunda linha: em curso e por fazer -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tile_em_curso"
            style="@style/TileRelatorio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem_pequena"
            app:layout_constraintEnd_toStartOf="@id/tile_por_fazer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tile_total">

            <TextView
                android:id="@+id/numero_em_curso"
                style="@style/TileNumero"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/azul"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                android:id="@+id/rotulo_em_curso"
                style="@style/TileRotulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/em_curso"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/numero_em_curso"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tile_por_fazer"
            style="@style/TileRelatorio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem_pequena"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tile_em_curso"
            app:layout_constraintTop_toBottomOf="@id/tile_total">

            <TextView
                android:id="@+id/numero_por_fazer"
                style="@style/TileNumero"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/texto"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                android:id="@+id/rotulo_por_fazer"
                style="@style/TileRotulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/por_fazer"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/numero_por_fazer"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Terceira linha: atrasadas (ocupa a largura toda) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tile_atrasadas"
            style="@style/TileRelatorio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem_pequena"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tile_em_curso">

            <TextView
                android:id="@+id/numero_atrasadas"
                style="@style/TileNumero"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/vermelho"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                android:id="@+id/rotulo_atrasadas"
                style="@style/TileRotulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/atrasadas"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/numero_atrasadas"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Tarefas por pessoa: as linhas são criadas no código (item_pessoa) -->
        <TextView
            android:id="@+id/titulo_pessoas"
            style="@style/TituloSecao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem_grande"
            android:text="@string/por_pessoa"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tile_atrasadas"/>

        <TextView
            android:id="@+id/texto_sem_atribuicoes"
            style="@style/TextoApoio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem_pequena"
            android:background="@drawable/bg_cartao"
            android:padding="@dimen/margem"
            android:text="@string/sem_atribuicoes"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/titulo_pessoas"/>

        <!-- Tarefas por pessoa: uma lista (RecyclerView + ListAdapter) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lista_pessoas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem_pequena"
            android:background="@drawable/bg_cartao"
            android:nestedScrollingEnabled="false"
            android:padding="@dimen/margem"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/titulo_pessoas"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
