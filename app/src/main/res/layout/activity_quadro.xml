<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">
        <TextView
            android:id="@+id/titulo_projeto"
            style="@style/TituloGrande"
            android:maxLines="2"
            android:ellipsize="end"/>
        <TextView style="@style/TextoApoio" android:text="@string/quadro_apoio"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:padding="20dp">
        <ImageButton
            android:id="@+id/botao_relatorio"
            style="@style/BotaoIcone"
            android:src="@drawable/ic_grafico"
            android:contentDescription="@string/relatorio"/>
        <ImageButton
            android:id="@+id/botao_membros"
            style="@style/BotaoIcone"
            android:src="@drawable/ic_pessoas"
            android:contentDescription="@string/membros"
            android:layout_marginStart="8dp"/>
        <ImageButton
            android:id="@+id/botao_nova_tarefa"
            style="@style/BotaoIcone"
            android:src="@drawable/ic_adicionar"
            android:contentDescription="@string/nova_tarefa"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_botao"
            app:tint="@android:color/white"/>
    </LinearLayout>
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs_estado"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_segmentos"
        app:tabBackground="@android:color/transparent"
        app:tabIndicator="@drawable/bg_segmento"
        app:tabIndicatorGravity="stretch"
        app:tabIndicatorFullWidth="true"
        app:tabIndicatorColor="@color/cartao"
        app:tabRippleColor="@android:color/transparent"
        app:tabTextAppearance="@style/TextoSegmento"
        app:tabTextColor="@color/texto_secundario"
        app:tabSelectedTextColor="@color/texto"
        app:tabPaddingStart="2dp"
        app:tabPaddingEnd="2dp"/>
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/linha_filtros"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"/>
    </HorizontalScrollView>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_quadro"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/lista_tarefas"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="24dp"/>
            <TextView
                android:id="@+id/texto_vazio"
                style="@style/TextoApoio"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="32dp"
                android:text="@string/sem_tarefas"/>
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
