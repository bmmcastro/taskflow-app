<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:fillViewport="true"
    android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                style="@style/TituloGrande"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/detalhe_da_tarefa"
                android:textSize="30sp"/>
            <ImageButton
                android:id="@+id/botao_apagar"
                style="@style/BotaoIcone"
                android:src="@drawable/ic_lixeira"
                android:contentDescription="@string/apagar"
                app:tint="@color/vermelho"/>
        </LinearLayout>
        <ProgressBar
            android:id="@+id/loading"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:visibility="gone"/>
        <Space android:layout_width="1dp" android:layout_height="20dp"/>
        <com.google.android.material.card.MaterialCardView
            style="@style/Cartao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">
                <TextView android:id="@+id/detalhe_titulo" style="@style/TituloSecao" android:textSize="26sp"/>
                <TextView
                    android:id="@+id/detalhe_descricao"
                    style="@style/TextoApoio"
                    android:layout_marginTop="12dp"/>
                <Space android:layout_width="1dp" android:layout_height="24dp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/detalhe_avatar"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_avatar"
                        android:gravity="center"
                        android:textColor="@color/roxo"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/detalhe_responsavel"
                        style="@style/TextoApoio"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="8dp"/>
                    <TextView
                        android:id="@+id/detalhe_estado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_botao_secundario"
                        android:padding="8dp"
                        android:textSize="12sp"
                        android:textStyle="bold"/>
                </LinearLayout>
                <TextView android:id="@+id/detalhe_prazo" style="@style/TextoApoio" android:layout_marginTop="20dp"/>
                <TextView
                    android:id="@+id/detalhe_link"
                    style="@style/TextoApoio"
                    android:textColor="@color/roxo"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botao_editar"
                    style="@style/BotaoTexto"
                    android:text="@string/editar_tarefa"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <Space android:layout_width="1dp" android:layout_height="16dp"/>
        <com.google.android.material.card.MaterialCardView
            style="@style/Cartao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">
                <TextView style="@style/TituloSecao" android:text="@string/subtarefas"/>
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/barra_progresso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    app:indicatorColor="@color/roxo"
                    app:trackColor="@color/roxo_suave"
                    app:trackThickness="6dp"
                    app:trackCornerRadius="3dp"/>
                <TextView
                    android:id="@+id/texto_percentagem"
                    style="@style/TextoApoio"
                    android:textSize="13sp"
                    android:layout_marginTop="10dp"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/lista_subtarefas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginTop="12dp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp">
                    <EditText
                        android:id="@+id/campo_nova_subtarefa"
                        style="@style/Campo"
                        android:hint="@string/adicionar_subtarefa"
                        android:inputType="textCapSentences"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:textSize="14sp"/>
                    <ImageButton
                        android:id="@+id/botao_adicionar_subtarefa"
                        style="@style/BotaoIcone"
                        android:src="@drawable/ic_adicionar"
                        android:contentDescription="@string/adicionar_subtarefa"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
