<?xml version="1.0" encoding="utf-8"?>
<!-- Detalhe da tarefa: ConstraintLayout em coluna com dois cartões
     (a tarefa e a checklist de subtarefas), também em ConstraintLayout. -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:fillViewport="true"
    android:clipToPadding="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/margem"
        android:paddingEnd="@dimen/margem"
        android:paddingBottom="@dimen/margem_grande">

        <!-- Título do ecrã + botão de apagar -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/linha_titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/titulo_ecra"
                style="@style/TituloGrande"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/detalhe_da_tarefa"
                android:textSize="30sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/botao_apagar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <ImageButton
                android:id="@+id/botao_apagar"
                style="@style/BotaoIcone"
                android:src="@drawable/ic_lixeira"
                android:contentDescription="@string/apagar"
                app:tint="@color/vermelho"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Indicador de carregamento: visível enquanto a tarefa é obtida. -->
        <ProgressBar
            android:id="@+id/loading"
            android:layout_width="@dimen/altura_indicador"
            android:layout_height="@dimen/altura_indicador"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/linha_titulo"/>

        <!-- A tarefa -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cartao_tarefa"
            style="@style/Cartao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/loading">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/espaco_22">

                <TextView
                    android:id="@+id/detalhe_titulo"
                    style="@style/TituloSecao"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="26sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <TextView
                    android:id="@+id/detalhe_descricao"
                    style="@style/TextoApoio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margem_pequena"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/detalhe_titulo"/>

                <!-- Responsável (avatar + nome) e etiqueta do estado -->
                <TextView
                    android:id="@+id/detalhe_avatar"
                    android:layout_width="@dimen/avatar_pequeno"
                    android:layout_height="@dimen/avatar_pequeno"
                    android:layout_marginTop="@dimen/espaco_24"
                    android:background="@drawable/bg_avatar"
                    android:gravity="center"
                    android:textColor="@color/roxo"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/detalhe_descricao"/>

                <TextView
                    android:id="@+id/detalhe_responsavel"
                    style="@style/TextoApoio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="@dimen/espaco_8"
                    app:layout_constraintBottom_toBottomOf="@id/detalhe_avatar"
                    app:layout_constraintEnd_toStartOf="@id/detalhe_estado"
                    app:layout_constraintStart_toEndOf="@id/detalhe_avatar"
                    app:layout_constraintTop_toTopOf="@id/detalhe_avatar"/>

                <TextView
                    android:id="@+id/detalhe_estado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_botao_secundario"
                    android:padding="@dimen/espaco_8"
                    android:textSize="@dimen/texto_mini"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/detalhe_avatar"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/detalhe_avatar"/>

                <TextView
                    android:id="@+id/detalhe_prazo"
                    style="@style/TextoApoio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margem"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/detalhe_avatar"/>

                <TextView
                    android:id="@+id/detalhe_link"
                    style="@style/TextoApoio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/margem_pequena"
                    android:paddingBottom="@dimen/margem_pequena"
                    android:textColor="@color/roxo"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/detalhe_prazo"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botao_editar"
                    style="@style/BotaoTexto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/editar_tarefa"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/detalhe_link"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Checklist de subtarefas -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cartao_subtarefas"
            style="@style/Cartao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cartao_tarefa">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/espaco_22">

                <TextView
                    android:id="@+id/titulo_subtarefas"
                    style="@style/TituloSecao"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/subtarefas"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <!-- Barra de progresso da checklist -->
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/barra_progresso"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    app:indicatorColor="@color/roxo"
                    app:trackColor="@color/roxo_suave"
                    app:trackThickness="6dp"
                    app:trackCornerRadius="3dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/titulo_subtarefas"/>

                <TextView
                    android:id="@+id/texto_percentagem"
                    style="@style/TextoApoio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textSize="@dimen/texto_secundario"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/barra_progresso"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/lista_subtarefas"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margem_pequena"
                    android:nestedScrollingEnabled="false"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/texto_percentagem"/>

                <!-- Campo de nova subtarefa + botão de adicionar -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/linha_nova_subtarefa"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margem_pequena"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/lista_subtarefas">

                    <EditText
                        android:id="@+id/campo_nova_subtarefa"
                        style="@style/Campo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:hint="@string/adicionar_subtarefa"
                        android:inputType="textCapSentences"
                        android:textSize="14sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/botao_adicionar_subtarefa"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <ImageButton
                        android:id="@+id/botao_adicionar_subtarefa"
                        style="@style/BotaoIcone"
                        android:layout_marginStart="@dimen/espaco_8"
                        android:src="@drawable/ic_adicionar"
                        android:contentDescription="@string/adicionar_subtarefa"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
