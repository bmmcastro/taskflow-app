<?xml version="1.0" encoding="utf-8"?>
<!-- Linha da lista de membros (ConstraintLayout): avatar, nome e email à
     esquerda, etiqueta de criador à direita quando é o caso. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/item_avatar"
        android:layout_width="@dimen/avatar_pequeno"
        android:layout_height="@dimen/avatar_pequeno"
        android:background="@drawable/bg_avatar"
        android:gravity="center"
        android:textColor="@color/roxo"
        android:textSize="@dimen/texto_apoio"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/item_nome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margem_pequena"
        android:layout_marginEnd="@dimen/espaco_8"
        android:textColor="@color/texto"
        android:textSize="@dimen/texto_normal"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/item_tag_criador"
        app:layout_constraintStart_toEndOf="@id/item_avatar"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/item_email"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/texto_secundario"
        android:textSize="@dimen/texto_secundario"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/item_nome"
        app:layout_constraintStart_toStartOf="@id/item_nome"
        app:layout_constraintTop_toBottomOf="@id/item_nome"/>

    <TextView
        android:id="@+id/item_tag_criador"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/espaco_8"
        android:background="@drawable/bg_botao_secundario"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="@dimen/espaco_4"
        android:paddingBottom="@dimen/espaco_4"
        android:text="@string/criado_por_ti"
        android:textColor="@color/texto_secundario"
        android:textSize="@dimen/texto_mini"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
