<?xml version="1.0" encoding="utf-8"?>
<!-- Formulário de novo projeto (diálogo): ConstraintLayout em coluna. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/margem_ecra"
    android:paddingEnd="@dimen/margem_ecra"
    android:paddingTop="@dimen/espaco_8">

    <EditText
        android:id="@+id/dialog_nome"
        style="@style/Campo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/nome_do_projeto"
        android:inputType="textCapSentences"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <EditText
        android:id="@+id/dialog_descricao"
        style="@style/Campo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margem_pequena"
        android:hint="@string/descricao"
        android:inputType="textCapSentences"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dialog_nome"/>

</androidx.constraintlayout.widget.ConstraintLayout>
