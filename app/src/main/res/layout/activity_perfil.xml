<?xml version="1.0" encoding="utf-8"?>
<!-- Perfil: ConstraintLayout em coluna (cada elemento fica por baixo do anterior). -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:fillViewport="true"
    android:clipToPadding="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/margem_ecra"
        android:paddingEnd="@dimen/margem_ecra"
        android:paddingBottom="@dimen/margem_grande"
        android:focusableInTouchMode="true">

        <TextView
            android:id="@+id/titulo_perfil"
            style="@style/TituloGrande"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/o_teu_perfil"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/texto_apoio_perfil"
            style="@style/TextoApoio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/perfil_apoio"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/titulo_perfil"/>

        <TextView
            android:id="@+id/perfil_avatar"
            android:layout_width="@dimen/avatar_perfil"
            android:layout_height="@dimen/avatar_perfil"
            android:layout_marginTop="@dimen/espaco_24"
            android:background="@drawable/bg_avatar"
            android:gravity="center"
            android:textColor="@color/roxo"
            android:textSize="34sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/texto_apoio_perfil"/>

        <TextView
            android:id="@+id/titulo_dados"
            style="@style/TituloSecao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem_grande"
            android:text="@string/dados_conta"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/perfil_avatar"/>

        <EditText
            android:id="@+id/perfil_nome"
            style="@style/Campo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_16"
            android:hint="@string/nome"
            android:inputType="textPersonName"
            android:autofillHints="name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/titulo_dados"/>

        <EditText
            android:id="@+id/perfil_email"
            style="@style/Campo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem_pequena"
            android:hint="@string/email"
            android:inputType="textEmailAddress"
            android:autofillHints="emailAddress"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/perfil_nome"/>

        <EditText
            android:id="@+id/perfil_password"
            style="@style/Campo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem_pequena"
            android:hint="@string/password_opcional"
            android:inputType="textPassword"
            android:autofillHints="newPassword"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/perfil_email"/>

        <!-- Indicador de carregamento: visível enquanto a conta é guardada. -->
        <ProgressBar
            android:id="@+id/loading"
            android:layout_width="@dimen/altura_indicador"
            android:layout_height="@dimen/altura_indicador"
            android:layout_marginTop="@dimen/margem_pequena"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/perfil_password"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botao_guardar_perfil"
            style="@style/BotaoPrimario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_24"
            android:text="@string/guardar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/loading"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botao_terminar_sessao"
            style="@style/BotaoTexto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem_pequena"
            android:text="@string/terminar_sessao"
            android:textColor="@color/vermelho"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/botao_guardar_perfil"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
