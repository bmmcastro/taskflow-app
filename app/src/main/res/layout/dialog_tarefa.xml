<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/campo_titulo"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_input"
            android:hint="@string/titulo"
            android:inputType="textCapSentences"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/texto"
            android:textColorHint="@color/texto_secundario"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/campo_descricao"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input"
            android:hint="@string/descricao"
            android:inputType="textCapSentences"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/texto"
            android:textColorHint="@color/texto_secundario"
            android:textSize="16sp" />

        <AutoCompleteTextView
            android:id="@+id/campo_responsavel"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input"
            android:completionThreshold="1"
            android:hint="@string/responsavel"
            android:inputType="none"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/texto"
            android:textColorHint="@color/texto_secundario"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/campo_prazo"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input"
            android:focusable="false"
            android:hint="@string/prazo"
            android:inputType="none"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/texto"
            android:textColorHint="@color/texto_secundario"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/campo_link"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input"
            android:hint="@string/link_opcional"
            android:inputType="textUri"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/texto"
            android:textColorHint="@color/texto_secundario"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
