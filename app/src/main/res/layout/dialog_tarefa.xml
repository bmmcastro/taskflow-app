<?xml version="1.0" encoding="utf-8"?>
<!-- Formulário de criar/editar tarefa (diálogo): ConstraintLayout em coluna.
     O responsável é escolhido numa lista e a coluna num Spinner. -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/margem_ecra"
        android:paddingEnd="@dimen/margem_ecra"
        android:paddingTop="@dimen/espaco_8"
        android:paddingBottom="@dimen/espaco_8">

        <EditText
            android:id="@+id/campo_titulo"
            style="@style/Campo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/titulo"
            android:inputType="textCapSentences"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <EditText
            android:id="@+id/campo_descricao"
            style="@style/Campo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem_pequena"
            android:hint="@string/descricao"
            android:inputType="textCapSentences"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/campo_titulo"/>

        <AutoCompleteTextView
            android:id="@+id/campo_responsavel"
            style="@style/Campo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem_pequena"
            android:completionThreshold="1"
            android:hint="@string/responsavel"
            android:inputType="none"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/campo_descricao"/>

        <TextView
            android:id="@+id/rotulo_coluna"
            style="@style/TextoApoio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem_pequena"
            android:text="@string/coluna"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/campo_responsavel"/>

        <!-- Spinner: em que coluna do quadro a tarefa fica -->
        <Spinner
            android:id="@+id/spinner_estado"
            android:layout_width="0dp"
            android:layout_height="@dimen/altura_botao_icone"
            android:gravity="center_vertical"
            android:contentDescription="@string/coluna"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rotulo_coluna"/>

        <EditText
            android:id="@+id/campo_prazo"
            style="@style/Campo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem_pequena"
            android:focusable="false"
            android:hint="@string/prazo"
            android:inputType="none"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/spinner_estado"/>

        <EditText
            android:id="@+id/campo_link"
            style="@style/Campo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem_pequena"
            android:hint="@string/link_opcional"
            android:inputType="textUri"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/campo_prazo"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
