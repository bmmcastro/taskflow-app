<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:fillViewport="true"
    android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:focusableInTouchMode="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <ImageButton
                android:id="@+id/botao_voltar"
                style="@style/BotaoIcone"
                android:src="@drawable/ic_voltar"
                android:contentDescription="@string/voltar"/>
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="20dp"/>
        <TextView style="@style/TituloGrande" android:text="@string/aceitar_convite"/>
        <TextView style="@style/TextoApoio" android:text="@string/convite_apoio"/>
        <Space android:layout_width="1dp" android:layout_height="28dp"/>
        <EditText
            android:id="@+id/campo_convite"
            style="@style/Campo"
            android:hint="@string/colar_link_convite"
            android:inputType="textUri"/>
        <Space android:layout_width="1dp" android:layout_height="16dp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/botao_ver"
            style="@style/BotaoPrimario"
            android:text="@string/ver_convite"/>
        <Space android:layout_width="1dp" android:layout_height="20dp"/>
        <TextView
            android:id="@+id/texto_convite"
            style="@style/TextoApoio"
            android:background="@drawable/bg_cartao"
            android:padding="24dp"
            android:visibility="gone"/>
        <Space android:layout_width="1dp" android:layout_height="20dp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/botao_aceitar"
            style="@style/BotaoPrimario"
            android:text="@string/aceitar_convite"
            android:visibility="gone"/>
    </LinearLayout>
</ScrollView>
