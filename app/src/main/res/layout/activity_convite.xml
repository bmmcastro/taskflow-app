<?xml version="1.0" encoding="utf-8"?>
<!-- Convite: ConstraintLayout em coluna (cada elemento fica por baixo do anterior). -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:fillViewport="true"
    android:clipToPadding="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/margem_ecra"
        android:focusableInTouchMode="true">

        <ImageButton
            android:id="@+id/botao_voltar"
            style="@style/BotaoIcone"
            android:src="@drawable/ic_voltar"
            android:contentDescription="@string/voltar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/titulo_convite"
            style="@style/TituloGrande"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem"
            android:text="@string/aceitar_convite"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/botao_voltar"/>

        <TextView
            android:id="@+id/texto_apoio_convite"
            style="@style/TextoApoio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/convite_apoio"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/titulo_convite"/>

        <EditText
            android:id="@+id/campo_convite"
            style="@style/Campo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem_grande"
            android:hint="@string/colar_link_convite"
            android:inputType="textUri"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/texto_apoio_convite"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botao_ver"
            style="@style/BotaoPrimario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_16"
            android:text="@string/ver_convite"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/campo_convite"/>

        <!-- Indicador de carregamento: visível enquanto o convite é consultado. -->
        <ProgressBar
            android:id="@+id/loading"
            android:layout_width="@dimen/altura_indicador"
            android:layout_height="@dimen/altura_indicador"
            android:layout_marginTop="@dimen/margem_pequena"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/botao_ver"/>

        <TextView
            android:id="@+id/texto_convite"
            style="@style/TextoApoio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem"
            android:background="@drawable/bg_cartao"
            android:padding="@dimen/margem_grande"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/loading"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botao_aceitar"
            style="@style/BotaoPrimario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem"
            android:text="@string/aceitar_convite"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/texto_convite"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
