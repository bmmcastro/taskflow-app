<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.TaskFlow" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/roxo</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="android:colorBackground">@color/fundo</item>
        <item name="colorSurface">@color/cartao</item>
        <item name="colorSurfaceContainer">@color/cartao</item>
        <item name="colorOnSurface">@color/texto</item>
        <item name="colorOnSurfaceVariant">@color/texto_secundario</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/barras_claras</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.TaskFlow.Dialog</item>
    </style>
    <style name="Theme.TaskFlow" parent="Base.Theme.TaskFlow"/>
    <style name="ThemeOverlay.TaskFlow.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.TaskFlow.Dialog</item>
    </style>
    <style name="ShapeAppearance.TaskFlow.Dialog" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">@dimen/espaco_24</item>
    </style>

    <!-- Títulos e textos de apoio -->
    <style name="TituloGrande">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/texto_titulo</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:paddingTop">@dimen/espaco_8</item>
        <item name="android:paddingBottom">@dimen/espaco_4</item>
    </style>
    <style name="TextoApoio">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/texto_apoio</item>
        <item name="android:lineSpacingExtra">@dimen/espaco_4</item>
        <item name="android:textColor">@color/texto_secundario</item>
    </style>
    <style name="TituloSecao" parent="TextoApoio">
        <item name="android:textSize">@dimen/texto_secao</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Campos de texto dos formulários -->
    <style name="Campo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/altura_botao</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">@dimen/espaco_16</item>
        <item name="android:paddingEnd">@dimen/espaco_16</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textColorHint">@color/texto_secundario</item>
        <item name="android:textSize">@dimen/texto_normal</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- Botões -->
    <style name="BotaoPrimario" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/altura_botao</item>
        <item name="android:textSize">@dimen/texto_botao</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="backgroundTint">@color/azul_botao</item>
        <item name="cornerRadius">@dimen/raio_botao</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="BotaoTexto" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/altura_botao_icone</item>
        <item name="android:textSize">@dimen/texto_apoio</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/roxo</item>
    </style>
    <style name="BotaoIcone">
        <item name="android:layout_width">@dimen/altura_botao_icone</item>
        <item name="android:layout_height">@dimen/altura_botao_icone</item>
        <item name="android:background">@drawable/bg_acao</item>
        <item name="android:padding">@dimen/margem_pequena</item>
        <item name="tint">@color/roxo</item>
    </style>

    <!-- Cartões -->
    <style name="Cartao" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/cartao</item>
        <item name="cardCornerRadius">@dimen/raio_cartao</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Blocos do relatório (um número por cima do rótulo) -->
    <style name="TileRelatorio">
        <item name="android:background">@drawable/bg_cartao</item>
        <item name="android:padding">@dimen/margem</item>
        <item name="android:layout_marginStart">@dimen/espaco_6</item>
        <item name="android:layout_marginEnd">@dimen/espaco_6</item>
    </style>
    <style name="TileNumero">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">@dimen/texto_numero</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TileRotulo" parent="TextoApoio">
        <item name="android:textSize">@dimen/texto_secundario</item>
    </style>
    <style name="TextoSegmento" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">@dimen/texto_mini</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
